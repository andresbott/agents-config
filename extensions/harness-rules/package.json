{
  "name": "pi-harness-rules",
  "version": "0.1.0",
  "description": "Pi extension: injects the user's standing harness rules (from <pi-agent-dir>/rules.d/*.md) into the system prompt every session — the Pi port of the Claude coding-guides SessionStart hook.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi", "pi-coding-agent", "harness-rules", "rules", "system-prompt"],
  "exports": { ".": "./index.ts" },
  "files": ["index.ts", "rules.ts", "README.md"],
  "scripts": {
    "test": "node --experimental-strip-types --test ./rules.test.ts ./index.test.ts"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true }
  }
}
