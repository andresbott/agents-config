{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "ask",

    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",

    "ffgrep": "allow",
    "fffind": "allow",
    "symbol_search": "allow",
    "project_report": "allow",
    "module_report": "allow",
    "read_symbol": "allow",
    "read_enclosing": "allow",
    "lens_diagnostics": "allow",
    "effective_config": "allow",
    "ast_grep_search": "allow",
    "ast_grep_outline": "allow",
    "pi_lens_activate_tools": "allow",
    "memory_read": "allow",
    "memory_search": "allow",
    "memory_status": "allow",
    "get_search_content": "allow",
    "bg_wait": "allow",

    "path_read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.netrc": "deny",
      "~/.git-credentials": "deny",
      "~/.config/gh/*": "deny",
      "~/.pi/agent/auth.json": "deny"
    },
    "path_write": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.netrc": "deny",
      "~/.git-credentials": "deny",
      "~/.config/gh/*": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/extensions/pi-permission-system/*": {
        "action": "deny",
        "reason": "The agent may not change its own permission policy; ask the user to edit it"
      }
    },
    "external_directory_read": "allow",
    "external_directory_write": "ask",

    "bash": {
      "*": "ask",

      "pwd": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "stat *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "md5sum *": "allow",
      "sha256sum *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "readlink *": "allow",
      "which *": "allow",
      "command -v *": "allow",
      "whoami": "allow",
      "hostname": "allow",
      "uname *": "allow",
      "date": "allow",
      "ps *": "allow",
      "jq *": "allow",

      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git merge-base *": "allow",
      "git branch": "allow",
      "git branch -v": "allow",
      "git branch -vv": "allow",
      "git branch -a": "allow",
      "git branch --show-current": "allow",
      "git remote -v": "allow",
      "git stash list": "allow",

      "sudo *": { "action": "deny", "reason": "No privilege escalation; ask the user to run it" },
      "doas *": { "action": "deny", "reason": "No privilege escalation; ask the user to run it" },
      "git push -f*": { "action": "deny", "reason": "Force-push is not allowed" },
      "git push * -f*": { "action": "deny", "reason": "Force-push is not allowed" },
      "git push *--force*": { "action": "deny", "reason": "Force-push is not allowed" }
    },

    "mcp": {
      "*": "ask",
      "mcp_status": "allow",
      "mcp_list": "allow",
      "mcp_search": "allow",
      "mcp_describe": "allow",
      "tokensave": "allow"
    },

    "skill": "allow"
  }
}
